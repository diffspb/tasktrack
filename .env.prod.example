# App
AUTH_STUB=false
KEYCLOAK_URL=https://auth.busypage.ru
KEYCLOAK_REALM=home
KEYCLOAK_CLIENT_ID=tasktrack
CORS_ORIGINS=https://tasktrack.busypage.ru

# Database — задать до первого запуска
DATABASE_URL=postgresql+asyncpg://tasktrack:CHANGE_ME@postgres:5432/tasktrack
POSTGRES_PASSWORD=CHANGE_ME

# MCP и REST для агентов: ключи служебных учётных записей, без переменных окружения:
#   docker compose ... exec app python scripts/service_account.py --help   (ADR-017)
# Устаревший способ (оставлен для существующих агентов):
# MCP_AGENTS=pm-secret-key:uuid1,exec-secret-key:uuid2
# APP_ENV=production задан в образе: AUTH_STUB=true и MCP без ключа запрещены.
